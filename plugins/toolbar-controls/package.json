{
  "name": "@magalz/toolbar-controls",
  "version": "0.1.0",
  "description": "Compact floating playback toolbar + Windows taskbar thumbnail controls for TidaLuna.",
  "author": {
    "name": "Magalz",
    "url": "https://github.com/magalz"
  },
  "homepage": "https://github.com/magalz/taskbar-controls-tidaluna",
